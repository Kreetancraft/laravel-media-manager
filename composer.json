{
    "name": "kreetancraft/laravel-media",
    "description": "Media library for Laravel — folders, picker, image editor and automatic WebP conversion. Livewire 4 + Flux UI.",
    "keywords": [
        "laravel",
        "livewire",
        "media",
        "media-library",
        "flux"
    ],
    "license": "MIT",
    "require": {
        "laravel/framework": "^12.0|^13.0",
        "livewire-filemanager/filemanager": "^1.1",
        "livewire/flux": "^2.0",
        "livewire/livewire": "^4.0",
        "lorisleiva/laravel-actions": "^2.7",
        "php": "^8.2",
        "sandermuller/laravel-fluent-validation": "^1.30",
        "spatie/image": "^3.0",
        "spatie/laravel-medialibrary": "^11.0|^12.0",
        "spatie/laravel-query-builder": "^6.0|^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/laravel-permission": "^6.0|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Kreetancraft\\Media\\": "src/"
        },
        "files": [
            "src/Helpers/media.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kreetancraft\\Media\\Tests\\": "tests/",
            "Kreetancraft\\Media\\Tests\\Fixtures\\": "tests/fixtures/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kreetancraft\\Media\\Providers\\MediaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
